MT5__TERMINAL_PATH=C:\\path\\to\\terminal64.exe
MT5__DATA_PATH=C:\\path\\to\\terminal\\data
MT5__DEMO_ONLY=true
MT5__SOURCE_UTC_OFFSET_MINUTES=0
BROKERS={"DEMO":{"terminal_path":"C:\\\\path\\\\to\\\\demo\\\\terminal64.exe","data_path":"C:\\\\path\\\\to\\\\demo\\\\terminal\\\\data","demo_only":true,"source_utc_offset_minutes":0}}
# Credentials are intentionally omitted.
# The research adapter never authenticates and rejects a non-empty MT5__PASSWORD.
# MT5 authentication must be managed inside the terminal, never in this repository.
# MT5__LOGIN=
# MT5__PASSWORD=
# MT5__SERVER=
DATA__TIMEZONE=UTC
DATA__MAX_ALIGNMENT_DELAY_MS=100
DATA__COLLECTION_MAX_WORKERS=2
DATA__COLLECTION_ATTEMPTS=3
DATA__REPORTS_DIRECTORY=reports/research
DASHBOARD__HOST=127.0.0.1
DASHBOARD__PORT=8501
RESEARCH__DEFAULT_TIMEFRAME=M1
RESEARCH__MINIMUM_OBSERVATIONS=100
RESEARCH__ZSCORE_WINDOW=100
RESEARCH__ROLLING_BETA_WINDOW=30
RESEARCH__STATISTICAL_SIGNIFICANCE=0.05
# Execution and capital assumptions. Latency must be positive: a zero round trip
# would report every measured opportunity as fully capturable.
COSTS__VOLUME=1.0
# COSTS__LEVERAGE=500
COSTS__LATENCY_ASSUMPTION_MS=50
COSTS__ADVERSE_MOVE_ALLOWANCE=0.0
COSTS__MINIMUM_CAPTURABLE_FRACTION=0.25
COSTS__MINIMUM_FILL_RATIO=0.0
SYMBOL_MAPPING={"EURUSD":"EURUSD","GBPUSD":"GBPUSD","USDJPY":"USDJPY","EURGBP":"EURGBP","EURJPY":"EURJPY","GBPJPY":"GBPJPY","XAUUSD":"XAUUSD","XAGUSD":"XAGUSD","XAUEUR":"XAUEUR","BTCUSD":"BTCUSD"}
